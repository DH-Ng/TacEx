###
# General settings -> used in the docker-compose.yaml
###

ISAAC_SIM_VER=5.1

# Isaac Lab base image
ISAACLAB_BASE_IMAGE=isaac-lab-base
# The Isaac Lab Extension Template path in the container
ISAACLAB_EXTENSION_TEMPLATE_PATH=/workspace/tacex

# The Isaac Lab path in the container
DOCKER_ISAACLAB_PATH=/workspace/isaaclab

CONDA_ENV_NAME="env_isaaclab"